# --- Existing (client-side, safe to expose) ---
VITE_SUPABASE_URL=
# New publishable key (sb_publishable_…) — preferred. Get it from Supabase →
# Project Settings → API Keys → Publishable and secret API keys → the "web" key.
VITE_SUPABASE_PUBLISHABLE_KEY=
# Legacy anon JWT — fallback only, kept during migration. Remove once legacy
# keys are disabled in Supabase and the publishable key is confirmed working.
VITE_SUPABASE_ANON_KEY=

# --- AI chat assistant (SERVER-ONLY — no VITE_ prefix, never bundled) ---
# Get a free Gemini key:  https://aistudio.google.com  (API key)
GEMINI_API_KEY=
# Get a free Groq key:    https://console.groq.com     (API keys)
GROQ_API_KEY=
# Default provider ("gemini" or "groq"). The function auto-fails-over to the other.
ACTIVE_PROVIDER=gemini

# --- Chat rate limiting (SERVER-ONLY) ---
# Service role key from Supabase → Project settings → API → service_role (secret!).
# Lets the chat function count requests per IP. If omitted, rate limiting is simply
# skipped (the chat still works). NEVER expose this key in the browser / VITE_ vars.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: the function reuses VITE_SUPABASE_URL if SUPABASE_URL isn't set.
# SUPABASE_URL=

# --- DPO Pay / DirectPay Online (SERVER-ONLY — never bundled, never in the repo) ---
# The account's API Company Token (a GUID). Set it in Netlify env vars only.
DPO_COMPANY_TOKEN=
# Numeric Service Type id from the DPO portal (identifies what's being paid for).
DPO_SERVICE_TYPE=
# Default charge currency (USD, ZAR, KES, GBP, EUR, …). Overridable per request.
DPO_CURRENCY=USD
# Optional overrides:
# DPO_API_URL=https://secure.dpopay.com/API/v6/
# Canonical site origin used to build the return/cancel URLs. On Netlify the
# built-in URL env is used automatically if this is unset.
# PUBLIC_SITE_URL=https://andrew-langeveldt.netlify.app
